# Canonical scientific source bytes keep provenance checks portable on Windows.
ml/*.py text eol=lf
ml/*.md text eol=lf
ml/*.txt text eol=lf
ml/browser/** text eol=lf
# These dependencies are hashed by both browser and Node extraction contracts.
src/ai/model.ts text eol=lf
src/ai/resample.ts text eol=lf
# Preserve the exact downloaded bytes covered by recorded experiment checksums.
ml/runs/** -text
# These opaque browser modules, configurations and weights have raw-byte pins.
public/ai/canonical-v3/** -text
# Preserve the unmodified ODbL directory snapshot and its recorded checksum.
public/data/datacenters-osm-2026-10-18.json -text
