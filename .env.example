# Server-only Redis REST credentials. Keep actual values in Vercel's environment
# settings or an ignored .env.local used by vercel dev. Never prefix these VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternate Vercel KV-compatible names are supported instead of the pair above.
# Use the read/write REST token, not a read-only token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
